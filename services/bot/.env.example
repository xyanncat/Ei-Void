# Copy to .env (gitignored) and fill in. Never commit the real values.
#
# Required. Only this worker ever sees the bot token; never send it to the web
# service. The application id is derived from the token automatically.
DISCORD_BOT_TOKEN=

# Optional. Overrides the application id derived from the token. A mismatched
# pasted value cannot win over the token that authenticates.
DISCORD_APPLICATION_ID=

# Required. The one Discord server this bot serves. Commands register in this
# guild only, guilds/DMs elsewhere are refused, and foreign invites are left.
DISCORD_GUILD_ID=848841415940898827

# Optional. Channel used for a mention when a user's DMs are closed.
DISCORD_FALLBACK_CHANNEL_ID=

# Required. Shared with the website service.
# DATABASE_URL=postgres://user:password@host:5432/eivoid

# Optional health server (Render worker port). Defaults to 8081.
BOT_HEALTH_PORT=8081

# Optional. Public website base used to build /link URLs. When empty, /link
# replies "not configured" instead of inventing a URL. RENDER_EXTERNAL_URL is
# read automatically as a fallback.
PUBLIC_BASE_URL=

# Optional mail delivery for reminder emails. Same provider variables as the
# website; with no provider the scheduler delivers Discord only.
# MAIL_PROVIDER=brevo
# MAIL_FROM=
# MAIL_FROM_NAME=Ei Void
# BREVO_API_KEY=
# SENDGRID_API_KEY=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
