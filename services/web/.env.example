# Local development. Copy to .env (gitignored); Render sets these itself.
NODE_ENV=development
PORT=3000
# PUBLIC_BASE_URL=https://void.example.com
# DATABASE_URL=postgres://user:password@host:5432/void
# Required in production; generate with: openssl rand -hex 32
SESSION_SECRET=
# Trusted first-party service token. Optional; the app API authenticates with
# Clerk bearer tokens, so this is only for callers that need a shared secret.
BOT_API_TOKEN=

# Clerk. The secret key stays server-side. The publishable key is public and
# encodes the frontend API host used by /sign-in.
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Public Discord application id used by the invite button.
DISCORD_APPLICATION_ID=1573240846223151144
# The single server the companion serves. The invite is locked to it.
DISCORD_GUILD_ID=848841415940898827
DISCORD_INVITE_PERMISSIONS=18432
# Only needed for POST /api/v1/test/discord. Never expose this to a browser.
# DISCORD_BOT_TOKEN=

# Optional. Defaults to xyanncat/Ei-Void; drives the GitHub links and releases.
# GITHUB_REPO=xyanncat/Ei-Void
# Required for /app/latest and /app/download.
# GITHUB_TOKEN=

# Mail. MAIL_PROVIDER may be gmail, brevo, sendgrid or smtp.
# MAIL_PROVIDER=smtp
# MAIL_FROM=hello@example.com
# MAIL_FROM_NAME=Ei Void
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# Optional. When omitted, the download page points at GitHub releases.
# DOWNLOAD_URL=https://github.com/xyanncat/Ei-Void/releases/download/v0.2.0/ei-void-0.2.0.apk
# RELEASES_URL=https://github.com/xyanncat/Ei-Void/releases
# FRONTEND_SIGN_IN_URL=https://void.example.com/sign-in
CONTACT_EMAIL=

# Render sets RENDER_EXTERNAL_URL automatically and the app uses it when
# PUBLIC_BASE_URL is absent.
