<section class="page-hero page-hero-compact">
  <div class="hero-stars" aria-hidden="true"></div>
  <div class="shell">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Sign in</p>
    <h1>One door.<br><em>One identity.</em></h1>
    <p class="page-lede">
      Ei Void uses Clerk for Discord, Google, email and GitHub sign-in. The
      website only sees the session Clerk issues; it never sees a password.
    </p>
  </div>
</section>

<section class="section">
  <div class="shell narrow">
    <% if (clerkEnabled) { %>
      <div class="callout callout-quiet">
        <span class="callout-mark" aria-hidden="true">i</span>
        <p>
          The sign-in widget below is served by Clerk's frontend API. It is the
          only third-party script this website loads, and it carries the same
          CSP nonce as every inline script.
        </p>
      </div>
      <div id="clerk-sign-in" class="clerk-mount" data-redirect="<%= redirectUrl %>"></div>

      <script
        src="https://<%= clerkFrontendApi %>/npm/@clerk/clerk-js@5/dist/clerk.browser.js"
        data-clerk-publishable-key="<%= clerkPublishableKey %>"
        crossorigin="anonymous"
        nonce="<%= nonce %>"
      ></script>
      <script nonce="<%= nonce %>">
        (function () {
          var mount = document.getElementById('clerk-sign-in');
          if (!mount) return;
          var target = mount.getAttribute('data-redirect') || '/dashboard';
          function fail() {
            mount.textContent = 'Clerk could not load. Refresh the page or try again later.';
          }
          function start() {
            if (!window.Clerk || typeof window.Clerk.load !== 'function') {
              fail();
              return;
            }
            window.Clerk.load()
              .then(function () {
                window.Clerk.mountSignIn(mount, {
                  afterSignInUrl: target,
                  afterSignUpUrl: target,
                });
              })
              .catch(fail);
          }
          if (window.Clerk) start();
          else window.addEventListener('load', start);
        })();
      </script>
    <% } else { %>
      <div class="callout callout-warn">
        <span class="callout-mark" aria-hidden="true">△</span>
        <div>
          <p class="callout-title">Sign-in is not configured on this server.</p>
          <p>
            Set <span class="mono">CLERK_SECRET_KEY</span>,
            <span class="mono">CLERK_PUBLISHABLE_KEY</span> and, when needed,
            <span class="mono">CLERK_ISSUER</span>. The API still accepts Clerk
            bearer tokens when the secret key is present.
          </p>
        </div>
      </div>
    <% } %>

    <p class="page-meta">
      <a class="text-link" href="/">Back to the site <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>
