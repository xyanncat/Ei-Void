<section class="docs-shell">
  <div class="shell docs-layout">
    <aside class="docs-sidebar">
      <%- include('../partials/docs-nav') %>
    </aside>

    <article class="doc-article">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/docs">Docs</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page"><%= doc.title %></span>
      </nav>
      <header class="doc-header">
        <p class="kicker">Guide</p>
        <h1><%= doc.title %></h1>
        <p class="page-lede"><%= doc.description %></p>
        <p class="page-meta">Updated 21 November 2026 · developer preview</p>
      </header>

      <div class="doc-body">
        <%- html %>
      </div>

      <div class="doc-help">
        <p>Something changed or broke?</p>
        <a class="text-link" href="<%= site.repoUrl %>/issues" target="_blank" rel="noreferrer">Open an issue <span aria-hidden="true">→</span></a>
      </div>

      <nav class="doc-pager" aria-label="Documentation pages">
        <% if (previous) { %>
          <a class="doc-pager-link" href="/docs/<%= previous.slug %>">
            <span class="doc-pager-label">Previous</span>
            <span><%= previous.title %></span>
          </a>
        <% } else { %>
          <span></span>
        <% } %>
        <% if (next) { %>
          <a class="doc-pager-link doc-pager-next" href="/docs/<%= next.slug %>">
            <span class="doc-pager-label">Next</span>
            <span><%= next.title %></span>
          </a>
        <% } %>
      </nav>
    </article>
  </div>
</section>
