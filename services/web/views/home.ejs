<section class="hero">
  <div class="hero-stars" aria-hidden="true"></div>
  <div class="hero-grain" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Android 13+ · Developer preview</p>
      <h1>Reminders<br><em>and code.</em></h1>
      <p class="hero-lede">
        Ei Void keeps your bills on time and your repository in reach. Synced
        reminders reach Discord or email; the coding agent clones, edits and
        pushes through guarded tools. Real git, a quiet chat, and a cat with a
        halo. No laptop required.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#waitlist">Join the preview</a>
        <a class="btn btn-ghost" href="/reminders">Reminders <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="/agent">The agent <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <dl class="hero-facts" aria-label="At a glance">
        <div><dt>Reminders</dt><dd>Discord + email</dd></div>
        <div><dt>Agent</dt><dd>On device</dd></div>
        <div><dt>Identity</dt><dd>Clerk</dd></div>
      </dl>
    </div>

    <div class="hero-visual">
      <div class="hero-halo" aria-hidden="true"></div>
      <figure class="phone-frame">
        <div class="phone-speaker" aria-hidden="true"></div>
        <div class="phone-screen">
          <img
            src="/screens/landing.webp"
            width="720"
            height="1600"
            alt="The Ei Void landing screen: a sketch cat with a halo, the Ei Void wordmark, and a Continue with Clerk button."
          >
        </div>
      </figure>
      <div class="hero-cat" aria-hidden="true">
        <img src="/brand/cat.jpg" width="180" height="180" alt="">
      </div>
      <p class="hero-caption">Gatete, keeping watch.</p>
    </div>
  </div>

  <div class="hero-ticker">
    <div class="shell ticker-row" aria-label="What is inside">
      <span>Bill reminders</span>
      <span>Real git</span>
      <span>Keystore keys</span>
      <span>No analytics</span>
      <span>Discord companion</span>
      <span>A cat</span>
    </div>
  </div>
</section>

<section class="section" id="pillars">
  <div class="shell">
    <div class="section-head">
      <p class="kicker">Two pillars</p>
      <h2 class="section-title">One app, two quiet jobs.</h2>
      <p class="section-lede">
        Ei Void began as a reminder app and grew a coding agent. Both share one
        Clerk identity, one Discord bot and one honest website.
      </p>
    </div>
    <div class="feature-grid">
      <article class="feature">
        <p class="feature-index">01</p>
        <h3>Never miss a bill</h3>
        <p>
          Add a payment once. Ei Void schedules the notification on the phone,
          syncs a snapshot to the website, and can reach you on Discord or by
          email when the day arrives.
        </p>
        <a class="text-link" href="/reminders">How reminders work <span aria-hidden="true">→</span></a>
      </article>
      <article class="feature">
        <p class="feature-index">02</p>
        <h3>Carry the repository</h3>
        <p>
          The agent runs on the phone with JGit and a typed tool registry.
          Clone, inspect, edit, review the diff and push — with a confirmation
          before anything sharp.
        </p>
        <a class="text-link" href="/agent">Meet the agent <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </div>
</section>

<section class="section" id="features">
  <div class="shell">
    <div class="section-head">
      <p class="kicker">What it is</p>
      <h2 class="section-title">A workspace that fits in a hand.</h2>
      <p class="section-lede">
        Not a thin client for a cloud IDE. Not a chatbot with a text box. A
        phone-native agent that can touch the repository, see the diff and ask
        before it changes the world.
      </p>
    </div>
    <div class="feature-grid">
      <% features.forEach(function (feature) { %>
        <article class="feature">
          <p class="feature-index"><%= feature.index %></p>
          <h3><%= feature.title %></h3>
          <p><%= feature.body %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<section class="section section-alt" id="how">
  <div class="shell">
    <div class="section-head">
      <p class="kicker">The loop</p>
      <h2 class="section-title">From pocket to push.</h2>
      <p class="section-lede">
        Four steps, one small screen. The agent moves the files; you keep the
        final say.
      </p>
    </div>
    <%- include('partials/how') %>
  </div>
</section>

<section class="section" id="tiers">
  <div class="shell">
    <div class="section-head">
      <p class="kicker">Three temperatures</p>
      <h2 class="section-title">Pick a tier, not a model name.</h2>
      <p class="section-lede">
        The router chooses the provider and model for the work. If one model
        fails, it tries another in the same tier before it moves down.
      </p>
    </div>
    <%- include('partials/tier-grid') %>
  </div>
</section>

<section class="section section-alt" id="plans">
  <div class="shell">
    <div class="section-head section-head-row">
      <div>
        <p class="kicker">Plans</p>
        <h2 class="section-title">A seat for every orbit.</h2>
        <p class="section-lede">
          Plans are a preview. Nothing is billed yet, and the counters stay on
          the phone until usage sync lands.
        </p>
      </div>
      <a class="text-link" href="/pricing">Compare plans <span aria-hidden="true">→</span></a>
    </div>
    <div class="plans-grid">
      <% plans.forEach(function (plan) { %>
        <%- include('partials/plan', { plan: plan }) %>
      <% }); %>
    </div>
    <p class="plan-note">
      Early-access pricing · no billing is live · tokens are counted per tier
      in the app
    </p>
  </div>
</section>

<section class="section" id="security">
  <div class="shell split">
    <div class="split-copy">
      <p class="kicker">The quiet part</p>
      <h2 class="section-title">Your keys stay in the Keystore.</h2>
      <p class="section-lede">
        Ei Void has no analytics, no telemetry and no server holding your repo.
        The keys that matter live behind Android's hardware-backed store, and
        the tools cannot leave the workspace.
      </p>
      <ul class="check-list">
        <li><span class="tick" aria-hidden="true">✓</span> Provider keys and the GitHub token in the Android Keystore</li>
        <li><span class="tick" aria-hidden="true">✓</span> File and git tools refuse paths outside the workspace</li>
        <li><span class="tick" aria-hidden="true">✓</span> Pushing needs a deliberate confirmation</li>
        <li><span class="tick" aria-hidden="true">✓</span> Sign-out wipes the session, chats, usage and workspace</li>
      </ul>
      <a class="text-link" href="/security">Read the security model <span aria-hidden="true">→</span></a>
    </div>
    <div class="split-visual">
      <div class="boundary-card">
        <div class="boundary-head">
          <span class="boundary-dot" aria-hidden="true"></span>
          <span class="mono">workspace boundary</span>
        </div>
        <pre class="boundary-code"><code>workspace/
├── .git/           <span class="dim">accepted</span>
├── src/            <span class="dim">accepted</span>
├── ../../keys      <span class="bad">refused</span>
└── /sdcard/...     <span class="bad">refused</span>

<span class="dim"># push is a separate confirmation</span>
<span class="ok">✓</span> confirm push to origin/main</code></pre>
      </div>
      <p class="boundary-caption">A typed tool registry, not a shell on your phone.</p>
    </div>
  </div>
</section>

<section class="section section-alt" id="discord">
  <div class="shell discord-section">
    <div class="discord-copy">
      <p class="kicker">A companion</p>
      <h2 class="section-title">The cat has a server.</h2>
      <p class="section-lede">
        Link Discord to Ei Void, then ask for usage without unlocking the phone.
        The bot is a long-running Node service; it never receives your
        repository, your provider keys or your GitHub token.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="<%= site.discordInviteUrl %>" target="_blank" rel="noreferrer">Add Ei Void to Discord</a>
        <a class="btn btn-ghost" href="/bot">Bot details <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <p class="small-note">
        <span class="status-dot" aria-hidden="true"></span>
        Verification is in preparation. The invite works once the worker is live.
      </p>
    </div>
    <%- include('partials/discord-window') %>
  </div>
</section>

<section class="section" id="docs">
  <div class="shell">
    <div class="section-head section-head-row">
      <div>
        <p class="kicker">Read the map</p>
        <h2 class="section-title">Start where you are.</h2>
        <p class="section-lede">
          Build the app, deploy the bridge, run the companion. The docs are
          written for the person who will actually type the commands.
        </p>
      </div>
      <a class="text-link" href="/docs">All docs <span aria-hidden="true">→</span></a>
    </div>
    <%- include('partials/docs-grid', { items: docs }) %>
  </div>
</section>

<section class="section section-alt" id="faq">
  <div class="shell faq-layout">
    <div class="faq-head">
      <p class="kicker">Questions</p>
      <h2 class="section-title">The honest answers.</h2>
      <p class="section-lede">
        A preview is a promise with a date. Here is what is true today.
      </p>
      <a class="text-link" href="/pricing">Plans and limits <span aria-hidden="true">→</span></a>
    </div>
    <%- include('partials/faq-list', { items: faqs.slice(0, 5) }) %>
  </div>
</section>

<section class="waitlist-section" id="waitlist">
  <div class="shell waitlist">
    <div class="waitlist-cat" aria-hidden="true">
      <img src="/brand/cat.jpg" width="220" height="220" alt="">
    </div>
    <div class="waitlist-copy">
      <p class="kicker">Early access</p>
      <h2 class="section-title">Be there when the void opens.</h2>
      <p class="section-lede">
        The preview is small on purpose. Leave an email and we'll send one
        note when the GitHub bridge and the signed APK are ready.
      </p>
    </div>
    <div class="waitlist-action">
      <%- include('partials/waitlist') %>
    </div>
  </div>
</section>
