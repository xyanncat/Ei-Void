<section class="dash-shell">
  <div class="shell">
    <header class="dash-head">
      <div>
        <p class="eyebrow">
          <span class="status-dot" aria-hidden="true"></span>
          Your dashboard
        </p>
        <h1>The quiet console.</h1>
        <p class="page-lede">
          Signed in with Clerk as <strong><%= user.email || user.userId %></strong>.
          This page shows the account, reminder summary, Discord link, plan,
          usage and device keys. No repository content, prompts or provider keys.
        </p>
      </div>
      <div class="dash-head-actions">
        <form action="/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-ghost btn-small" type="submit">Sign out</button>
        </form>
      </div>
    </header>

    <% if (notice) { %>
      <div class="notice" role="status">
        <span class="status-dot" aria-hidden="true"></span>
        <p><%= notice %></p>
      </div>
    <% } %>

    <% if (!account) { %>
      <div class="demo-banner">
        <span class="chip">No account row yet</span>
        <p>
          Sign-in works, but the app has not synced a profile or reminders for
          this Clerk user. Open the app and sync once, then reload this page.
        </p>
        <a class="text-link" href="/docs/api">API docs <span aria-hidden="true">→</span></a>
      </div>
    <% } %>

    <div class="dash-grid">
      <section class="dash-card dash-identity" aria-labelledby="identity-title">
        <div class="dash-card-head">
          <h2 id="identity-title">Account</h2>
          <span class="chip <%= account ? '' : 'chip-quiet' %>"><%= account ? 'synced' : 'empty' %></span>
        </div>
        <div class="identity">
          <span class="identity-avatar" aria-hidden="true"><img src="/brand/icon-192.png" width="64" height="64" alt=""></span>
          <div>
            <p class="identity-name"><%= account && account.displayName ? account.displayName : (user.email || 'Ei Void account') %></p>
            <p class="identity-id mono"><%= user.userId %></p>
          </div>
        </div>
        <dl class="identity-facts">
          <div><dt>Email</dt><dd><%= account && account.email ? account.email : 'Not synced' %></dd></div>
          <div><dt>Timezone</dt><dd><%= account ? account.timezone : 'UTC' %></dd></div>
          <div><dt>Notify</dt><dd><%= account ? String(account.notifyHour).padStart(2, '0') + ':' + String(account.notifyMinute).padStart(2, '0') : '09:00' %></dd></div>
          <div><dt>Email alerts</dt><dd><%= account && account.emailEnabled ? 'On' : 'Off' %></dd></div>
          <div><dt>Plan</dt><dd><%= plan %></dd></div>
        </dl>
      </section>

      <section class="dash-card dash-usage" aria-labelledby="usage-title">
        <div class="dash-card-head">
          <h2 id="usage-title">Usage</h2>
          <span class="chip"><%= plan %></span>
        </div>
        <% if (synced && usage) { %>
          <div class="usage-numbers">
            <p class="usage-big"><%= Number(usage.tokensUsed).toLocaleString('en-IN') %></p>
            <p class="usage-of">of <%= Number(limit).toLocaleString('en-IN') %> tokens</p>
          </div>
          <div class="usage-bar-row">
            <label class="sr-only" for="usage-progress">Token usage</label>
            <progress id="usage-progress" class="usage-progress" value="<%= percent %>" max="100"><%= percent %>%</progress>
            <span class="usage-percent"><%= percent %>%</span>
          </div>
          <p class="usage-meta">
            <% if (usage.periodEnd) { %>Resets <%= usage.periodEnd %> · <% } %>
            Synced from the app
            <%= new Date(usage.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %>
          </p>
        <% } else { %>
          <div class="usage-empty">
            <p class="usage-big">—</p>
            <p class="usage-of">No usage snapshot has reached the website yet.</p>
          </div>
          <div class="usage-bar-row" aria-hidden="true">
            <progress class="usage-progress" value="0" max="100">0%</progress>
            <span class="usage-percent">0%</span>
          </div>
          <p class="usage-meta">The plan limit comes from the shared plan catalogue (<%= Number(limit).toLocaleString('en-IN') %> tokens).</p>
        <% } %>
      </section>

      <section class="dash-card" aria-labelledby="reminders-title">
        <div class="dash-card-head">
          <h2 id="reminders-title">Reminders</h2>
          <span class="chip chip-quiet"><%= reminders.active %> active</span>
        </div>
        <dl class="identity-facts">
          <div><dt>Total</dt><dd><%= reminders.total %></dd></div>
          <div><dt>Active</dt><dd><%= reminders.active %></dd></div>
          <div><dt>Paid</dt><dd><%= reminders.paid %></dd></div>
          <div><dt>Next due</dt><dd><%= reminders.nextDueAt ? new Date(reminders.nextDueAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—' %></dd></div>
        </dl>
        <p class="dash-hint">
          The summary is computed from the last snapshot the app synced through
          <span class="mono">POST /api/v1/reminders/sync</span>.
        </p>
      </section>

      <section class="dash-card dash-bot" aria-labelledby="discord-title">
        <div class="dash-card-head">
          <h2 id="discord-title">Discord</h2>
          <span class="chip <%= discord ? '' : 'chip-quiet' %>"><%= discord ? 'linked' : 'not linked' %></span>
        </div>
        <% if (discord) { %>
          <div class="identity">
            <span class="identity-avatar" aria-hidden="true"><img src="/brand/icon-192.png" width="64" height="64" alt=""></span>
            <div>
              <p class="identity-name"><%= discord.username %></p>
              <p class="identity-id mono"><%= discord.id %></p>
            </div>
          </div>
          <form action="/dashboard/discord/unlink" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-ghost btn-small" type="submit">Unlink Discord</button>
          </form>
        <% } else { %>
          <p>
            Run <span class="mono">/link</span> in the Discord server where the
            bot lives, open the private URL, and confirm while signed in here.
          </p>
          <a class="btn btn-ghost btn-small" href="<%= site.discordInviteUrl %>" target="_blank" rel="noreferrer">Add Ei Void to Discord</a>
        <% } %>
        <p class="dash-hint">The bot token stays on the server and is never rendered here.</p>
      </section>

      <section class="dash-card dash-device" aria-labelledby="device-title">
        <div class="dash-card-head">
          <h2 id="device-title">Device keys</h2>
          <span class="chip chip-quiet">for the app</span>
        </div>

        <% if (newDeviceKey) { %>
          <div class="key-callout">
            <p class="key-title">Your new device key. It is shown once.</p>
            <div class="key-row">
              <code id="device-key" class="key-code"><%= newDeviceKey %></code>
              <button class="copy-btn" type="button" data-copy="#device-key">Copy</button>
            </div>
            <p class="key-note">
              Stored hashed; this page cannot show it again. Revoke it here if it
              leaks.
            </p>
            <pre class="key-example"><code>curl -X POST <%= site.baseUrl %>/api/v1/usage \
  -H "Authorization: Bearer &lt;device-key&gt;" \
  -H "Content-Type: application/json" \
  -d '{"plan":"<%= plan %>","tokensUsed":1200000,"tokensLimit":<%= limit %>}'</code></pre>
            <p class="key-note">
              Only counters and the plan. Do not send repository content,
              prompts or keys. <a class="text-link" href="/docs/api">API docs <span aria-hidden="true">→</span></a>
            </p>
          </div>
        <% } else { %>
          <p>
            Create a one-time key so the Android app can push its usage ledger to
            this dashboard. The bot then has a snapshot to read.
          </p>
          <form action="/dashboard/devices" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-primary btn-small" type="submit">Create device key</button>
          </form>
        <% } %>

        <% if (devices.length > 0) { %>
          <ul class="bot-command-list">
            <% devices.forEach(function (device) { %>
              <li>
                <code>#<%= device.id %></code>
                <span>
                  created <%= new Date(device.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                  <% if (device.lastSeenAt) { %>· last seen <%= new Date(device.lastSeenAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %><% } %>
                  <% if (device.revokedAt) { %>· <strong>revoked</strong><% } %>
                </span>
                <% if (!device.revokedAt) { %>
                  <form action="/dashboard/devices/<%= device.id %>/revoke" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-ghost btn-small" type="submit">Revoke</button>
                  </form>
                <% } %>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p class="dash-hint">No device keys issued yet.</p>
        <% } %>
      </section>

      <section class="dash-card" aria-labelledby="danger-title">
        <div class="dash-card-head">
          <h2 id="danger-title">Delete data</h2>
          <span class="chip chip-warn">irreversible</span>
        </div>
        <p>
          This deletes the account row, its reminders, usage snapshots, device
          keys and Discord link. The Clerk identity and the phone's local data
          are not touched by this action.
        </p>
        <form action="/dashboard/delete" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-ghost btn-small" type="submit">Delete website data</button>
        </form>
        <p class="dash-hint">To remove the phone's own data, clear the app's storage or uninstall it.</p>
      </section>
    </div>

    <footer class="dash-foot">
      <p>
        This dashboard stores the Clerk identity, reminder snapshot, Discord
        identity and usage counters. It does not store repository content,
        prompts or provider keys.
      </p>
      <a class="text-link" href="/privacy">Privacy <span aria-hidden="true">→</span></a>
    </footer>
  </div>
</section>
