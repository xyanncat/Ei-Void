<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="<%= site.name %> home">
      <img class="brand-mark" src="/brand/icon-192.png" alt="" width="38" height="38">
      <span class="brand-word">EI VOID</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <span class="menu-line" aria-hidden="true"></span>
      <span class="menu-line" aria-hidden="true"></span>
    </button>

    <nav class="site-nav" id="site-menu" aria-label="Primary">
      <a class="nav-link <%= currentPath === '/reminders' ? 'is-active' : '' %>" href="/reminders">Reminders</a>
      <a class="nav-link <%= currentPath === '/agent' ? 'is-active' : '' %>" href="/agent">Agent</a>
      <a class="nav-link <%= currentPath === '/features' ? 'is-active' : '' %>" href="/features">Features</a>
      <a class="nav-link <%= currentPath === '/pricing' ? 'is-active' : '' %>" href="/pricing">Plans</a>
      <a class="nav-link <%= currentPath.startsWith('/docs') ? 'is-active' : '' %>" href="/docs">Docs</a>
      <a class="nav-link <%= currentPath === '/bot' ? 'is-active' : '' %>" href="/bot">Discord</a>
      <div class="nav-actions">
        <a class="nav-cta" href="/download">Get the app</a>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light theme">
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.5"/>
            <path d="M12 2.5v2.2M12 19.3v2.2M4.3 4.3l1.6 1.6M18.1 18.1l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.3 19.7l1.6-1.6M18.1 5.9l1.6-1.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M20.2 14.2A8.4 8.4 0 0 1 9.8 3.8 8.4 8.4 0 1 0 20.2 14.2Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>
