      <a href="/docs">Documentation</a>
      <a href="/docs/getting-started">Getting started</a>
      <a href="/docs/self-hosting">Self-hosting</a>
      <a href="/docs/api">API</a>
      <a href="/security">Security</a>
    </nav>

    <nav class="footer-col" aria-label="Companion">
