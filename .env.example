# Ei Void — local development environment.
# Copy to .env and fill locally. Never commit .env.

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=dev-only-session-secret-change-me-please

# Clerk (Ei Void application)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=

# Postgres. Without it the services use non-persistent behavior and fail closed.
DATABASE_URL=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=848841415940898827
DISCORD_FALLBACK_CHANNEL_ID=
DISCORD_INVITE_PERMISSIONS=18432
BOT_HEALTH_PORT=8081

# Mail (one provider)
MAIL_PROVIDER=
MAIL_FROM=
MAIL_FROM_NAME=Ei Void
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
BREVO_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# APK updater
GITHUB_REPO=xyanncat/Ei-Void
GITHUB_TOKEN=

# Public contact
CONTACT_EMAIL=
